#
# Image proxy (README.md). Every variable of every adapter (Node, Bun, Deno,
# Vercel, Cloudflare Workers). The proxy doesn't read this file by itself:
# give the values to the process (systemd EnvironmentFile, docker --env-file,
# your host's settings). Never commit the real values. Empty means unset.

# --- Required ---------------------------------------------------------------

# The app's public URL: its origin is the only CORS origin allowed.
APP_URL=https://mail.example.com

# Ticket signing keys, the same as the web's IMAGE_PROXY_KEYS, newest first:
#   IMAGE_PROXY_KEYS=2:<base64url, 32 bytes>,1:<older key>
# Generate one: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
IMAGE_PROXY_KEYS=

# --- Server (Node, Bun and Deno) --------------------------------------------

# Defaults: 127.0.0.1 and 3003. 0.0.0.0 in Docker.
#IMAGE_PROXY_HOST=127.0.0.1
#IMAGE_PROXY_PORT=3003

# --- Cache: leave it all empty for no cache ---------------------------------

# Days to keep images, whole days, from 1, no maximum. Default 30.
#IMAGE_CACHE_TTL_DAYS=30

# Disk (Node, Bun and Deno). Not together with S3.
#IMAGE_CACHE_DIR=/var/cache/nebula-images
# Disk cap in bytes, oldest entries deleted first. Default: none.
#IMAGE_CACHE_MAX_BYTES=

# S3 or compatible (any adapter). The bucket turns it on; then endpoint and
# both keys are required. The endpoint is an origin, without a path.
#IMAGE_CACHE_S3_BUCKET=
#IMAGE_CACHE_S3_ENDPOINT=https://s3.example.com
#IMAGE_CACHE_S3_ACCESS_KEY_ID=
#IMAGE_CACHE_S3_SECRET_ACCESS_KEY=
#IMAGE_CACHE_S3_SESSION_TOKEN=
# Defaults: us-east-1 and path. virtual: bucket.endpoint.
#IMAGE_CACHE_S3_REGION=us-east-1
#IMAGE_CACHE_S3_URL_STYLE=path

# --- Vercel only ------------------------------------------------------------

# none (default), vercel-blob or s3.
#IMAGE_CACHE_STORAGE=none
# Required with any storage, 16+ characters: the cron enforces the retention.
#CRON_SECRET=
# One of the two is required with vercel-blob (read by @vercel/blob).
#BLOB_READ_WRITE_TOKEN=
#BLOB_STORE_ID=

# --- Cloudflare Workers only ------------------------------------------------

# DNS over HTTPS endpoint. Default: Cloudflare's. R2 and rate limits are
# bindings: see wrangler.example.toml.
#IMAGE_PROXY_DOH_URL=

# --- Preload (Node, Bun, Deno and Vercel; README "Preload") -----------------

# Turns preload on. Needs a cache. 32+ characters. The relay uses it too.
#IMAGE_PRELOAD_SECRET=
# Key of the recipient hashes (quota and opt-out), 32+ characters. Default:
# the secret. Set it before rotating the secret, or both are lost. The relay
# needs the same one.
#IMAGE_PRELOAD_INDEX_KEY=
# true: add an email token header, for the static build. Default false.
#IMAGE_PRELOAD_EMAIL_TOKENS=false
# Per recipient address. Defaults: 256 MiB and 10000 images.
#IMAGE_PRELOAD_MAX_BYTES_PER_RECIPIENT=268435456
#IMAGE_PRELOAD_MAX_IMAGES_PER_RECIPIENT=10000

# DANGER, true: accept the whole email from Stalwart's MTA Hook. Whoever runs
# this proxy can read every incoming email. Without it, use the relay
# (deploy/relay/relay.env.example has its own variables). Default false.
#IMAGE_PRELOAD_FULL_EMAIL=false
# Bigger hook requests are accepted without preloading. Default 25 MiB.
#IMAGE_PRELOAD_MAX_MESSAGE_BYTES=26214400
