#
# systemd unit for the preload relay (README "Preload › Relay").
# Assumes the repository at /opt/nebulamail (bun install done) and a
# system user: useradd --system --no-create-home --shell /usr/sbin/nologin nebula-relay
# It parses hostile HTML, so it runs without privileges, read-only, and can
# only open sockets; still limit its outgoing traffic to the proxy in the firewall.

[Unit]
Description=Nebula Mail preload relay (sends only image URLs to the image proxy)
After=network-online.target
Wants=network-online.target
Before=stalwart.service

[Service]
Type=simple
User=nebula-relay
Group=nebula-relay
EnvironmentFile=/etc/nebula-preload-relay/relay.env
WorkingDirectory=/opt/nebulamail/packages/image-proxy
ExecStart=/usr/bin/node --import ./scripts/node-resolve-ts.ts src/node/relay-server.ts
Restart=on-failure
RestartSec=2s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Node's JIT needs writable+executable memory: MemoryDenyWriteExecute stays off.
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
