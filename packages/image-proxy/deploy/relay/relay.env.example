#
# Preload relay (README "Preload › Relay"). Copy to /etc/nebula-preload-relay/relay.env,
# owner root, group nebula-relay, mode 0640. Never commit the real values.

# Stalwart's MTA Hook -> relay. 32+ random characters (openssl rand -hex 32).
# Must differ from IMAGE_PRELOAD_SECRET.
IMAGE_PRELOAD_RELAY_SECRET=

# Relay -> proxy: the proxy's base URL and its IMAGE_PRELOAD_SECRET.
IMAGE_PRELOAD_UPSTREAM=https://img.example.com
IMAGE_PRELOAD_SECRET=

# Only if the proxy has its own IMAGE_PRELOAD_INDEX_KEY (the hashes must match).
#IMAGE_PRELOAD_INDEX_KEY=

# true: ask the proxy for email token headers (static build; on in the proxy too).
#IMAGE_PRELOAD_EMAIL_TOKENS=false

# Keep it on loopback: only Stalwart on this machine should reach it.
IMAGE_PRELOAD_RELAY_HOST=127.0.0.1
IMAGE_PRELOAD_RELAY_PORT=3004
