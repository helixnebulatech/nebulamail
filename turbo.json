{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "APP_URL",
        "JMAP_SERVER",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "SESSION_KEYS",
        "IMAGE_PROXY_ORIGIN",
        "IMAGE_PROXY_KEYS",
        "REMOTE_IMAGES_DEFAULT",
        "REMOTE_IMAGES_VIA_DEFAULT",
        "REMOTE_IMAGES_ALLOW_DIRECT",
        "REMOTE_IMAGES_FORCE_NEVER",
        "VERIFIED_SENDER_BADGE"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "passThroughEnv": [
        "APP_URL",
        "JMAP_SERVER",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "SESSION_KEYS",
        "IMAGE_PROXY_ORIGIN",
        "IMAGE_PROXY_KEYS",
        "REMOTE_IMAGES_DEFAULT",
        "REMOTE_IMAGES_VIA_DEFAULT",
        "REMOTE_IMAGES_ALLOW_DIRECT",
        "REMOTE_IMAGES_FORCE_NEVER",
        "VERIFIED_SENDER_BADGE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "JMAP_SERVER",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "SESSION_KEYS",
        "IMAGE_PROXY_ORIGIN",
        "IMAGE_PROXY_KEYS",
        "REMOTE_IMAGES_DEFAULT",
        "REMOTE_IMAGES_VIA_DEFAULT",
        "REMOTE_IMAGES_ALLOW_DIRECT",
        "REMOTE_IMAGES_FORCE_NEVER",
        "VERIFIED_SENDER_BADGE"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "APP_URL",
        "JMAP_SERVER",
        "OAUTH_CLIENT_ID",
        "OAUTH_CLIENT_SECRET",
        "SESSION_KEYS",
        "IMAGE_PROXY_ORIGIN",
        "IMAGE_PROXY_KEYS",
        "REMOTE_IMAGES_DEFAULT",
        "REMOTE_IMAGES_VIA_DEFAULT",
        "REMOTE_IMAGES_ALLOW_DIRECT",
        "REMOTE_IMAGES_FORCE_NEVER",
        "VERIFIED_SENDER_BADGE"
      ]
    }
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
