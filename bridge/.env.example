#
# The bridge is configured with a file (bridge.example.toml, docs/bridge.md).
# These are its only variables. Never commit the real values.

# Master key, instead of secrets.master_key_file. Back it up: without it the
# stored passwords can't be read. Generate one: nebula-bridge gen-master-key
#NEBULA_BRIDGE_MASTER_KEY=

# Log filter (tracing). Default: the bridge's own, in the code.
#RUST_LOG=info
