# Copy to docker/.env (git-ignored) and change the password.
# Fixed admin credentials for the local Stalwart (format user:password).
STALWART_RECOVERY_ADMIN=admin:change-me-local-only

# `bun run dev:setup` writes these: leave them out at first.
#STALWART_ADMIN_USER=
#STALWART_ADMIN_PASSWORD=
#TEST_ALICE_PASSWORD=
#TEST_BOB_PASSWORD=
#TEST_CAROL_PASSWORD=

# Password of every account of the test Dovecot. Default: password.
#TEST_DOVECOT_PASSWORD=password

# Only to test the static zip by hand (docs/static.md): the throwaway Stalwart.
#STALWART_STATIC_RECOVERY_ADMIN=admin:change-me-local-only

# The rest is for tests, set in the shell when running them, not here.
#
# Rust tests against real servers (bridge/tests/src/lib.rs):
#   NEBULA_TEST_IMAP=1 NEBULA_TEST_SMTP=1 NEBULA_TEST_SIEVE=1 NEBULA_TEST_DAV=1
#   NEBULA_TEST_SPLIT_DAV=1 NEBULA_TEST_BAIKAL=1 NEBULA_TEST_DNS=1
#   NEBULA_TEST_SERVER=stalwart  (or dovecot...)
#   NEBULA_TEST_ENV_FILE=docker/.env
#
# Web tests (ports, when several checkouts run at once):
#   E2E_PORT=3117 E2E_BRIDGE_WEB_PORT=3118 E2E_BRIDGE_PORT=8191
#   E2E_BRIDGE_DAV_URL=http://127.0.0.1:5232/ E2E_BRIDGE_SMTP=postfix
#   E2E_STATIC_PROXY_PORT=8096
#
# test:live and the packages' live tests:
#   MAIL_LIVE_URL=http://localhost:8080 MAIL_LIVE_ALICE_PASSWORD MAIL_LIVE_BOB_PASSWORD
#
# scripts/ci-local.sh (explained at the top of the script):
#   CI_LOCAL_SKIP_MAIL=1 CI_LOCAL_DEV_SETUP=1 CI_LOCAL_PLAYWRIGHT_DEPS=1
#   CI_LOCAL_QUIET=1 CI_LOCAL_CI=0
