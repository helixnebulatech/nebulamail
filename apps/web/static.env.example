#
# Static build (docs/static.md): read while building, not when running, so
# changing one means building the zip again. Set them in the shell before
# `bun run build:static`. There are no secrets here: all of this ends up in
# the zip. The normal build uses .env.schema instead.

# Where Stalwart mounts the app (its urlPrefix): one path segment.
NEBULA_BASE_PATH=nebulamail

# The OAuth client registered in Stalwart.
NEBULA_OAUTH_CLIENT_ID=nebulamail

# Services the app asks for at login, the same as the client's scopes: mail
# plus any of contacts calendars files. Empty: all four.
NEBULA_OAUTH_SERVICES=

# Your image proxy, for preloaded images. https. Empty: none.
NEBULA_IMAGE_PROXY_ORIGIN=

# Set it to rebuild the same zip byte for byte. Empty: random.
NEBULA_STYLE_NONCE=
