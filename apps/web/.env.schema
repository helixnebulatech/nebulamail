# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Public URL of this app, without a trailing slash. OAuth redirects go to
# <APP_URL>/auth/callback. Local values: apps/web/.env.local (bun run dev:setup).
# @public @dynamic @type=url
APP_URL=

# The JMAP and OIDC server (Stalwart). One fixed server per install, so there
# is no "choose your server" screen. Write it exactly as the
# server's OAuth `issuer` (its /.well-known/oauth-authorization-server, RFC 8414): Stalwart and
# the bridge publish their public URL without a trailing slash, e.g.
# https://mail.example.com. It is compared character for character (OIDC
# Discovery §4.3, RFC 8414 §3.3), so `https://mail.example.com/` fails.
# @public @dynamic @type=url
JMAP_SERVER=

# Full BFF mode: on, the browser never
# gets a JMAP access token. All JMAP (API, uploads, downloads, push) goes
# browser → this server (session cookie) → JMAP server, which can then live
# on an internal network. /auth/token answers 404 and the CSP no longer lets
# pages talk to JMAP_SERVER. The login page of JMAP_SERVER must still be
# public (docs/jmap-proxy.md lists its paths). Push needs long-lived
# responses: on hosts that cut them, the app reconnects. Empty: off (the
# browser gets a short token and talks to JMAP_SERVER itself).
# @public @dynamic @optional @type=enum(on, off)
JMAP_PROXY=

# Where this server reaches the JMAP and OAuth server, when that is not
# JMAP_SERVER (its public URL): e.g. http://stalwart:8080 in Docker. Used for
# the proxy above and for this server's own calls (tokens, image tickets,
# unsubscribe). URLs on JMAP_SERVER's origin that the server hands out are
# moved here. Origin only: no path, query, fragment or user:password; plain
# http only for loopback, private IPs and internal names (`stalwart`,
# `*.internal`, `*.lan`...). Not sent to browsers. Empty: JMAP_SERVER.
# @dynamic @optional @type=url
JMAP_INTERNAL_URL=

# `@dynamic`: read when the server starts, not baked in at build time, so
# one build can be deployed anywhere.
#
# OAuth client registered in Stalwart (confidential client).
# @public @dynamic
OAUTH_CLIENT_ID=

OAUTH_CLIENT_SECRET=

# Services the app asks for at login, the same as the OAuth client's
# `scopes` in Stalwart (a client may only ask for its own): any of
# mail contacts calendars files, mail required. Empty: all four.
# Without one, the app hides what needs it.
# @public @dynamic @optional
OAUTH_SERVICES=

# AES-256-GCM keys for the session cookie, newest first:
#   SESSION_KEYS=2:<base64url, 32 bytes>,1:<older key>
# The first key encrypts; all of them decrypt (rotation without logging users out).
# Generate one: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SESSION_KEYS=

# Image proxy. Both optional: without them remote images are
# never loaded (mode "off"). Must be a different origin than APP_URL
# (e.g. https://img.example.com), so it never sees the app's cookies.
# @public @dynamic @optional @type=url
IMAGE_PROXY_ORIGIN=

# HMAC keys for image tickets, shared with the proxy, newest first:
#   IMAGE_PROXY_KEYS=2:<base64url, 32 bytes>,1:<older key>
# @optional
IMAGE_PROXY_KEYS=

# Remote images in emails. Each user chooses in Settings ›
# General › Privacy; these set the defaults and what users may choose. A
# contradiction (e.g. VIA_DEFAULT=direct with ALLOW_DIRECT=false) stops the
# server when it starts.

# When they load, for users who haven't chosen: never, ask (a button per
# email), trusted-senders (at once from contacts and senders the user
# trusts; ask for the rest), always. Empty: ask.
# @public @dynamic @optional @type=enum(never, ask, trusted-senders, always)
REMOTE_IMAGES_DEFAULT=

# How they load, for users who haven't chosen: proxy (needs the proxy above)
# or direct (straight from the sender, who sees the user's IP address).
# Empty: the proxy if there is one, else direct (and then a click with the
# IP warning, never at once).
# @public @dynamic @optional @type=enum(proxy, direct)
REMOTE_IMAGES_VIA_DEFAULT=

# true: users may also load images straight from the sender; false: they
# can't (without a proxy, remote images then never load). Empty: allowed
# only when there is no proxy, or when REMOTE_IMAGES_VIA_DEFAULT=direct.
# Straight from the sender, an email can point the browser at a public name
# that resolves to a device on the user's network (a router, a printer):
# the browser can't check where a name points, the proxy can.
# @public @dynamic @optional @type=boolean
REMOTE_IMAGES_ALLOW_DIRECT=

# true: remote images never load for anyone, and the setting shows it's
# locked. Empty: false.
# @public @dynamic @optional @type=boolean
REMOTE_IMAGES_FORCE_NEVER=

# The green "Verified sender" badge (DMARC passed). Without it the app only
# warns when the check FAILS, which is safe with any server.
# DANGER: read docs/verified-sender.md first. The badge can be wrong:
#   - if your mail server doesn't add its own Authentication-Results header to
#     ALL mail, including its own users' (Stalwart: addAuthResultsHeader on
#     every path; bun run dev:setup does it), any local user can fake it;
#   - mail received before you set that up, and imported mail, can show a
#     fake badge;
#   - "verified" only means the From domain is real, not that the sender is
#     honest (look-alike domains, free and hacked accounts pass).
#   empty: each user decides in Settings (off by default)
#   true / false: forced for everyone (the setting shows it's locked)
# @public @dynamic @optional @type=boolean
VERIFIED_SENDER_BADGE=
